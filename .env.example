NODE_ENV=production
PORT=3100

# Comma-separated browser origins allowed to call the VPS API.
MDT_CORS_ORIGINS=https://m88projecttracker.netlify.app,http://localhost:3100,http://127.0.0.1:3100

# Optional tracker token. Leave blank only for trusted private networks.
MDT_AUTH_TOKEN=replace-with-a-long-random-token

# HQ Supabase connection used by Sync HQ / Push HQ.
HQ_SUPABASE_URL=https://your-project.supabase.co
HQ_SUPABASE_KEY=replace-with-supabase-key

# Optional PPT runtime overrides on the VPS.
PPT_RUNTIME_PYTHON=
PPT_SKILL_DIR=

# Number of database snapshots to retain.
MDT_BACKUP_KEEP=30
